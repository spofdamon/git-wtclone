#!/usr/bin/env python3
"""git-wtclone — create a git worktree with APFS clonefile(2) instead of a checkout.

Instead of materialising every tracked file from the object database, clone an
existing worktree's directory tree (one clonefile(2) per top-level entry, which
the kernel recurses) and let git apply only the commit delta. Untracked and
ignored files come along for free, and the clone shares blocks with the source
so it costs almost no disk.

Two ways to deal with the fact that cloned files have new inodes and ctimes,
which git's index does not expect:

  default     rewrite the copied index's ctime/ino/dev/uid/gid fields from a
              fresh lstat pass and recompute the trailing checksum. Keeps stock
              git semantics and changes no config; costs one pass over the index.

  --no-patch  leave .git untouched and persist core.checkStat=minimal in the new
              worktree instead, so git compares only whole-second mtime and size.
              Marginally faster, but a change preserving both (rsync -t, cp -p,
              tar -p) becomes invisible in that worktree.

--exclude and --exclude-ignored leave things behind by not cloning them: a
directory holding an excluded *directory* is recreated and its keepers cloned
individually, so the excluded bytes are never paid for. Excluded *files* are
cheaper to clone and unlink than to sidestep, so those come off afterwards.

Falls back to a plain `git worktree add` whenever the fast path does not apply.
"""

import argparse
import ctypes
import hashlib
import os
import re
import shutil
import struct
import subprocess
import sys
import time

# clonefile(2) lives in libSystem; no compiled helper is needed. Threading it
# does not help — the kernel already saturates the APFS metadata path from one
# thread — so this stays deliberately serial.
_libc = ctypes.CDLL("/usr/lib/libSystem.B.dylib", use_errno=True)
_libc.clonefile.argtypes = [ctypes.c_char_p, ctypes.c_char_p, ctypes.c_uint32]
_libc.clonefile.restype = ctypes.c_int

# Past roughly half the tree changing, git's own checkout is faster than
# clone-then-apply-the-delta, so hand back to it.
DELTA_FALLBACK_RATIO = 0.5

# `git rev-parse --show-object-format` (2.29) is the newest thing used here;
# `git config --worktree` (2.20) and `--absolute-git-dir` (2.13) came earlier.
MIN_GIT = (2, 29)

# If this many tracked files are absent from the clone, something went wrong
# and a mostly-stale index is not worth writing.
MAX_MISSING_RATIO = 0.02

S_IFMT, S_IFDIR, S_IFREG, S_IFLNK, S_IFGITLINK = (
    0o170000, 0o040000, 0o100000, 0o120000, 0o160000)

# Without CLONE_NOFOLLOW clonefile(2) follows a symlink given as the source: the
# clone becomes a regular file holding the target's bytes (git sees a typechange)
# and a dangling link fails with ENOENT outright. It is documented as applying
# only when the source is not a directory, so passing it always is safe.
CLONE_NOFOLLOW = 0x0001

# What a prune tree maps a name to when nothing about it is excluded.
KEEP = object()


class Unsupported(Exception):
    """The fast path does not apply; caller should fall back to git."""


def clonefile(src, dst):
    if _libc.clonefile(os.fsencode(src), os.fsencode(dst), CLONE_NOFOLLOW) != 0:
        err = ctypes.get_errno()
        raise OSError(err, os.strerror(err), src, None, dst)


def git(*args, cwd=None, capture=True, check=True):
    r = subprocess.run(("git",) + args, cwd=cwd, check=check, text=True,
                       stdout=subprocess.PIPE if capture else None,
                       stderr=subprocess.PIPE if capture else None)
    return r.stdout.strip() if capture else ""


def git_ok(*args, cwd=None):
    return subprocess.run(("git",) + args, cwd=cwd, stdout=subprocess.DEVNULL,
                          stderr=subprocess.DEVNULL).returncode == 0


def nul_list(out):
    """Split the -z output of a git command into paths."""
    return [p for p in out.split("\0") if p]


def git_version():
    m = re.search(r"(\d+)\.(\d+)", git("--version", check=False))
    return (int(m.group(1)), int(m.group(2))) if m else (0, 0)


# --------------------------------------------------------------------------
# index patching (default; disabled by --no-patch)
# --------------------------------------------------------------------------

def patch_index(index_path, worktree, hash_len):
    """Refresh the stat fields git recorded for the *source* worktree so they
    describe the clone instead. Returns (total, patched, missing, skipped).

    Only ctime/dev/ino/uid/gid can differ: clonefile(2) preserves mtime to the
    nanosecond, along with size and mode.

    mtime and size are deliberately NOT touched, and must stay that way. They
    are the fields that carry content identity: under --dirty a modified file
    keeps the stale mtime the index recorded while it was clean, which is what
    still lets git see it as modified. "Helpfully" refreshing mtime here would
    mark every uncommitted change in the new worktree clean, and the next
    checkout would silently discard it.

    Entry lengths never change, so the TREE/EOIE/IEOT extensions and their
    offsets stay valid and only the trailing checksum is recomputed.
    """
    try:
        return _patch_index(index_path, worktree, hash_len)
    except Unsupported:
        raise
    except (struct.error, ValueError, IndexError) as e:
        # A malformed index must degrade to a fallback, never a traceback.
        raise Unsupported(f"malformed index ({type(e).__name__}: {e})")


def _patch_index(index_path, worktree, hash_len):
    data = bytearray(open(index_path, "rb").read())
    if len(data) < 12 + hash_len or bytes(data[:4]) != b"DIRC":
        raise Unsupported("not a DIRC index")
    version, count = struct.unpack_from(">II", data, 4)
    if version not in (2, 3):
        # v4 prefix-compresses path names, so entries can't be walked this way.
        raise Unsupported(f"index version {version} unsupported")

    tail = len(data) - hash_len          # first byte of the trailing checksum
    fixed = 40 + hash_len + 2            # stat block + object name + flags
    off, patched, missing, skipped = 12, 0, 0, 0

    for i in range(count):
        start = off
        if start + fixed > tail:
            raise Unsupported(f"entry {i} runs past the end of the index")
        flags = struct.unpack_from(">H", data, start + 40 + hash_len)[0]
        extended = bool(flags & 0x4000)
        if extended and version < 3:
            raise Unsupported("extended flag set in a v2 index")
        name_off = start + fixed + (2 if extended else 0)

        namelen = flags & 0x0FFF
        if namelen < 0x0FFF:
            path_end = name_off + namelen
        else:                                   # length didn't fit in 12 bits
            path_end = data.find(b"\0", name_off, tail)
            if path_end < 0:
                raise Unsupported(f"entry {i} has an unterminated path")
        if path_end >= tail:
            raise Unsupported(f"entry {i} path runs past the end of the index")
        path = bytes(data[name_off:path_end])

        # entry is NUL-terminated then padded out to a multiple of 8 bytes
        off = start + (((path_end + 1 - start) + 7) & ~7)
        if off > tail:
            raise Unsupported(f"entry {i} padding runs past the end of the index")

        kind = struct.unpack_from(">I", data, start + 24)[0] & S_IFMT
        if kind == S_IFDIR:
            # A sparse index stores directory entries; those are not files we
            # can stat meaningfully, and ls-files no longer maps 1:1 to entries.
            raise Unsupported("sparse index (directory entries)")
        if kind not in (S_IFREG, S_IFLNK):
            skipped += 1                        # gitlink, or something exotic
            continue
        if extended and struct.unpack_from(">H", data, start + fixed)[0] & 0x4000:
            skipped += 1                        # skip-worktree: absent by design
            continue

        try:
            st = os.lstat(os.path.join(worktree, os.fsdecode(path)))
        except OSError:
            missing += 1
            continue

        # git narrows every one of these to 32 bits when it records them
        m = 0xFFFFFFFF
        struct.pack_into(">II", data, start + 0,
                         int(st.st_ctime) & m, st.st_ctime_ns % 1_000_000_000)
        struct.pack_into(">II", data, start + 16, st.st_dev & m, st.st_ino & m)
        struct.pack_into(">II", data, start + 28, st.st_uid & m, st.st_gid & m)
        patched += 1

    considered = patched + missing
    if considered and missing / considered > MAX_MISSING_RATIO:
        raise Unsupported(f"{missing} of {considered} tracked files are missing "
                          f"from the clone")

    # Walk the extensions. This must land exactly on the trailer: if it does
    # not, the entry walk above desynced and the bytes just patched were not
    # the ones intended.
    entries_end, scan = off, off
    while scan < tail:
        if scan + 8 > tail:
            raise Unsupported("truncated extension header")
        sig = bytes(data[scan:scan + 4])
        size = struct.unpack_from(">I", data, scan + 4)[0]
        if not (sig.isascii() and sig.isalpha()):
            raise Unsupported(f"implausible extension signature {sig!r} "
                              f"— the entry table did not parse as expected")
        body = scan + 8
        if body + size > tail:
            raise Unsupported(f"extension {sig.decode()} runs past the end "
                              f"of the index")
        if sig == b"link":
            # A split index keeps its real entries elsewhere.
            raise Unsupported("split index (link extension)")
        if sig == b"FSMN":
            # The token and clean-bitmap describe the *source* worktree.
            raise Unsupported("fsmonitor extension present")
        if sig == b"EOIE" and size >= 4:
            # EOIE records where the entries end — an authoritative cross-check.
            recorded = struct.unpack_from(">I", data, body)[0]
            if recorded != entries_end:
                raise Unsupported(f"EOIE says entries end at {recorded}, "
                                  f"walk ended at {entries_end}")
        scan = body + size
    if scan != tail:
        raise Unsupported("extension table does not end at the trailer")

    algo = hashlib.sha1 if hash_len == 20 else hashlib.sha256
    data[tail:] = algo(bytes(data[:tail])).digest()

    tmp = index_path + ".wtclone"
    try:
        with open(tmp, "wb") as f:
            f.write(data)
            f.flush()
            os.fsync(f.fileno())
        os.replace(tmp, index_path)
    except BaseException:
        if os.path.exists(tmp):
            os.unlink(tmp)
        raise
    return count, patched, missing, skipped


# --------------------------------------------------------------------------
# exclusions
# --------------------------------------------------------------------------

def parse_excludes(values):
    """Normalise --exclude values (comma-separated, repeatable) to relative paths.

    Literal paths only, deliberately no patterns. Routing them through git
    pathspecs would have given globs for free but is quietly wrong: git collapses
    a wholly-untracked directory to the directory itself, so `*/node_modules`
    matches nothing under one. A path that means what it says is worth more here.
    """
    out = []
    for raw in values or []:
        for item in raw.split(","):
            path = item.strip().rstrip("/")
            if not path:
                continue
            norm = os.path.normpath(path)
            if os.path.isabs(norm) or norm == "." or norm.split("/")[0] == "..":
                sys.exit(f"fatal: --exclude takes paths inside the worktree, "
                         f"got {item.strip()!r}")
            out.append(norm)
    return out


def prune_tree(paths):
    """Nest exclusion paths: {'target': None, 'sub': {'b': None}}.

    None means "do not clone this at all"; a dict means "descend, this holds
    something excluded". An ancestor excluded outright absorbs anything finer
    beneath it, in either order.
    """
    root = {}
    for path in paths:
        parts = path.split("/")
        node = root
        for part in parts[:-1]:
            if node.get(part, {}) is None:
                break                       # already excluded whole, higher up
            node = node.setdefault(part, {})
        else:
            node[parts[-1]] = None
    return root


def containing_dirs(paths):
    """Every directory with one of paths beneath it: a/b/c.txt -> {a, a/b}."""
    dirs = set()
    for path in paths:
        d = os.path.dirname(path)
        while d and d not in dirs:
            dirs.add(d)
            d = os.path.dirname(d)
    return dirs


def ignored_dirs(src_wt):
    """Directories `git clean -Xd` would remove, worktree-relative.

    Whole directories only. They hold the bytes worth not cloning (target/,
    node_modules/, .venv/), whereas enumerating every scattered *.pyc up front
    costs more than cloning them and letting the clean pass take them afterwards.

    `-o` reports untracked paths only, so a directory holding tracked files is
    never collapsed into one entry here — git lists the individual ignored files
    inside it instead. The caller re-checks that regardless: skipping a directory
    with tracked content would leave the patched index describing files that are
    not there.
    """
    out = git("ls-files", "-o", "-i", "--directory", "--exclude-standard", "-z",
              cwd=src_wt, check=False)
    return [p.rstrip("/") for p in nul_list(out) if p.endswith("/")]


def excluded_paths(prune, base=""):
    """Every path a prune tree excludes, relative to the tree it applies to."""
    for name, sub in prune.items():
        path = base + name
        if sub is None:
            yield path
        else:
            yield from excluded_paths(sub, path + "/")


def only_files(src, prune):
    """True if nothing the prune tree excludes under src is a real directory.

    Which is the cheap case, and worth telling apart: clonefile(2) shares blocks,
    so cloning a file and deleting it again costs nothing however large it is,
    while descending to avoid it costs a clone call for every sibling it has. A
    directory is the opposite — it can hold a whole node_modules, and that is
    exactly what must not be cloned only to be removed.
    """
    for name, sub in prune.items():
        path = os.path.join(src, name)
        if sub is None:
            if os.path.isdir(path) and not os.path.islink(path):
                return False
        elif not only_files(path, sub):
            return False
    return True


def clone_tree(src, dst, prune, stats, root=False):
    """clonefile every entry of src into dst, honouring the prune tree.

    Names mapped to None are not cloned. A name mapped to a subtree holds
    something excluded, and is handled whichever way is cheaper:

      descend      recreate the directory and clone its keepers one by one, so
                   the excluded directory is never cloned at all. Costs one call
                   per sibling instead of one for the whole tree, which is the
                   price of not paying for the excluded bytes twice.

      clone whole  when only files are excluded beneath it: clone the directory
                   in one call and unlink them afterwards. Deleting a file the
                   kernel cloned by reference is free; enumerating its siblings
                   is not.

    Either way the fan-out cost is bounded by the excluded path's ancestors.
    Everything off that path is still one clonefile(2) recursed by the kernel.
    """
    for name in os.listdir(src):
        if root and name == ".git":
            continue                        # ours was made by `worktree add`
        s, d = os.path.join(src, name), os.path.join(dst, name)
        sub = prune.get(name, KEEP)
        if sub is None:
            stats["excluded"] += 1
            continue
        # A prune subtree under something that is not a directory (or is a
        # symlink to one) describes a path that cannot exist, so only_files sees
        # no directory to avoid and the whole thing is cloned as it stands.
        if sub is not KEEP and os.path.isdir(s) and not os.path.islink(s):
            if not only_files(s, sub):
                os.mkdir(d)
                clone_tree(s, d, sub, stats)
                # Mode is all there is to carry: clonefile(2) does not preserve
                # directory mtimes either, so this matches the rest of the tree.
                os.chmod(d, os.stat(s).st_mode & 0o7777)
                continue
            clonefile(s, d)
            stats["cloned"] += 1
            for rel in excluded_paths(sub):
                try:
                    os.unlink(os.path.join(d, rel))
                    stats["excluded"] += 1
                except (FileNotFoundError, NotADirectoryError):
                    pass                    # excluded a path that isn't there
            continue
        clonefile(s, d)
        stats["cloned"] += 1


# --------------------------------------------------------------------------
# worktree construction
# --------------------------------------------------------------------------

def preflight(src_wt, dst, args):
    """Raise Unsupported if the clone path can't be used safely."""
    if sys.platform != "darwin":
        raise Unsupported("not macOS")
    if os.path.exists(dst):
        raise Unsupported(f"{dst} already exists")

    parent = os.path.dirname(os.path.abspath(dst)) or "."
    if not os.path.isdir(parent):
        raise Unsupported(f"{parent} does not exist")
    if os.stat(parent).st_dev != os.stat(src_wt).st_dev:
        raise Unsupported("destination is on a different volume")

    if not args.dirty:
        dirty = git("status", "--porcelain", "--untracked-files=no", cwd=src_wt)
        if dirty:
            raise Unsupported("source worktree has uncommitted changes "
                              "(use --dirty to clone them too)")

    if os.path.exists(os.path.join(src_wt, ".gitmodules")):
        status = git("submodule", "status", cwd=src_wt, check=False)
        # a leading '-' means "not initialised", which is harmless to clone
        if any(l and not l.startswith("-") for l in status.splitlines()):
            raise Unsupported("initialised submodules (their .git files point "
                              "back at the source repo)")


def resolve_checkout(args, path):
    """Mirror `git worktree add`'s branch DWIM. Returns argv for git checkout."""
    if args.b:
        return ["checkout", "-b", args.b, args.commitish or "HEAD"]
    if args.B:
        return ["checkout", "-B", args.B, args.commitish or "HEAD"]
    if args.detach:
        return ["checkout", "--detach", args.commitish or "HEAD"]
    if args.commitish:
        # an existing branch is checked out; anything else detaches
        return ["checkout", args.commitish]
    return ["checkout", "-b", os.path.basename(os.path.abspath(path)), "HEAD"]


def fallback_argv(args, path):
    # --exclude and --exclude-ignored need no translation: a plain checkout
    # materialises tracked files only, so it carries nothing they would drop.
    argv = ["worktree", "add"]
    if args.b:
        argv += ["-b", args.b]
    if args.B:
        argv += ["-B", args.B]
    if args.detach:
        argv += ["--detach"]
    if args.force:
        argv += ["--force"]
    if args.quiet:
        argv += ["-q"]
    argv += [path]
    if args.commitish:
        argv += [args.commitish]
    return argv


def main():
    p = argparse.ArgumentParser(
        prog="git wtclone",
        description="Create a git worktree using APFS clonefile(2).")
    p.add_argument("path")
    p.add_argument("commitish", nargs="?")
    p.add_argument("-b", metavar="BRANCH", help="create a new branch")
    p.add_argument("-B", metavar="BRANCH", help="create or reset a branch")
    p.add_argument("-d", "--detach", action="store_true", help="detach HEAD")
    p.add_argument("-f", "--force", action="store_true")
    p.add_argument("--from", dest="source", metavar="PATH",
                   help="worktree to clone from (default: current)")
    p.add_argument("--no-patch", dest="no_patch", action="store_true",
                   help="leave .git untouched; persist core.checkStat=minimal "
                        "in the new worktree instead of rewriting its index")
    p.add_argument("--clean", action="store_true",
                   help="drop untracked and ignored files after cloning")
    p.add_argument("--exclude", metavar="PATHS", action="append",
                   help="comma-separated paths not to carry over (repeatable); "
                        "literal worktree-relative paths, not patterns")
    p.add_argument("--exclude-ignored", dest="exclude_ignored",
                   action="store_true",
                   help="do not carry over gitignored files")
    p.add_argument("--dirty", action="store_true",
                   help="allow cloning a source worktree with local changes")
    p.add_argument("--no-clone", action="store_true",
                   help="skip the fast path entirely")
    p.add_argument("-q", "--quiet", action="store_true")
    p.add_argument("-v", "--verbose", action="store_true", help="show timings")
    args = p.parse_args()
    excludes = parse_excludes(args.exclude)

    def say(msg):
        if not args.quiet:
            print(msg, file=sys.stderr)

    if not git_ok("rev-parse", "--git-dir"):
        sys.exit("fatal: not a git repository")

    dst = os.path.abspath(args.path)
    timings = {}

    def run_fallback(reason):
        say(f"wtclone: {reason}; using git worktree add")
        os.execvp("git", ["git"] + fallback_argv(args, args.path))

    if args.no_clone:
        run_fallback("--no-clone")
    have = git_version()
    if have < MIN_GIT:
        run_fallback(f"git {have[0]}.{have[1]} is older than "
                     f"{MIN_GIT[0]}.{MIN_GIT[1]}")

    # Anything unexpected while working out what to clone (bare repo, no work
    # tree, unresolvable ref) means git should handle this and report its own
    # diagnostic rather than us surfacing a traceback.
    try:
        src_wt = (os.path.abspath(args.source) if args.source
                  else git("rev-parse", "--show-toplevel"))
        preflight(src_wt, dst, args)
        src_head = git("rev-parse", "HEAD", cwd=src_wt)
        requested = ((args.b and (args.commitish or "HEAD"))
                     or args.commitish or "HEAD")
        target = git("rev-parse", "--verify", "--quiet", requested + "^{commit}",
                     cwd=src_wt, check=False)
        if not target:
            # let git worktree add produce the authoritative diagnostic
            raise Unsupported(f"cannot resolve {requested!r}")

        # Past ~half the tree changing, a plain checkout wins. -z keeps paths
        # with unusual characters unquoted, since the exclusion checks below
        # match against these same two lists.
        t = time.perf_counter()
        delta = nul_list(git("diff", "--name-only", "-z", src_head, target,
                             cwd=src_wt))
        listed = nul_list(git("ls-files", "-z", cwd=src_wt))
        changed, total = len(delta), len(listed)
        timings["delta_probe"] = time.perf_counter() - t
        if total and changed / total > DELTA_FALLBACK_RATIO:
            raise Unsupported(f"{changed} files differ (source tree has {total})")

        # Tracked at HEAD, or about to be created by the delta checkout.
        tracked = set(listed) | set(delta)
        parents = containing_dirs(tracked)
        held = [p for p in excludes if p in tracked or p in parents]
        if held:
            # A hard error rather than a fallback: dropping tracked content would
            # leave the index describing files that are not there, and falling
            # back to `git worktree add` would silently keep the very paths the
            # caller asked to exclude.
            sys.exit("fatal: --exclude names tracked path(s): "
                     + ", ".join(sorted(held)))

        skip = list(excludes)
        if args.exclude_ignored:
            t = time.perf_counter()
            skip += [d for d in ignored_dirs(src_wt) if d not in parents]
            timings["ignored_probe"] = time.perf_counter() - t
        prune = prune_tree(skip)
    except Unsupported as e:
        run_fallback(str(e))
    except (subprocess.CalledProcessError, OSError) as e:
        run_fallback(f"cannot use fast path ({e.__class__.__name__})")

    created = False
    try:
        t = time.perf_counter()
        git("worktree", "add", "--no-checkout", "--detach", dst, src_head, cwd=src_wt)
        created = True
        timings["worktree_add"] = time.perf_counter() - t

        t = time.perf_counter()
        stats = {"cloned": 0, "excluded": 0}
        clone_tree(src_wt, dst, prune, stats, root=True)
        timings["clone_tree"] = time.perf_counter() - t

        admin = git("rev-parse", "--absolute-git-dir", cwd=dst)
        src_admin = git("rev-parse", "--absolute-git-dir", cwd=src_wt)
        t = time.perf_counter()
        shutil.copyfile(os.path.join(src_admin, "index"), os.path.join(admin, "index"))
        timings["copy_index"] = time.perf_counter() - t

        checkout_cfg = []
        if not args.no_patch:
            fmt = git("rev-parse", "--show-object-format", cwd=dst, check=False)
            if fmt not in ("sha1", "sha256"):
                raise Unsupported("cannot determine the repository object format")
            hash_len = 32 if fmt == "sha256" else 20

            index = os.path.join(admin, "index")
            t = time.perf_counter()
            try:
                total_e, n, missing, skipped = patch_index(index, dst, hash_len)
                # Make git re-read what we wrote. This is the net under every
                # assumption above about the on-disk format: if the index no
                # longer parses, or no longer describes the same number of
                # entries, the patch was wrong regardless of why.
                listed = git("ls-files", cwd=dst, check=False)
                if len(listed.splitlines()) != total_e:
                    raise Unsupported("patched index failed to read back")
            except Unsupported as e:
                shutil.copyfile(os.path.join(src_admin, "index"), index)
                # Deliberately not degrading to --no-patch here: that would
                # silently relax core.checkStat the caller did not ask for.
                raise Unsupported(f"cannot patch index ({e}) — "
                                  f"pass --no-patch to take the fast path anyway")
            timings["patch_index"] = time.perf_counter() - t
            if args.verbose:
                say(f"wtclone: patched {n}/{total_e} index entries "
                    f"({missing} missing, {skipped} skipped)")
        else:
            if git("config", "--get", "extensions.worktreeConfig",
                   cwd=src_wt, check=False) != "true":
                # Enabling worktreeConfig makes these apply per-worktree, so git
                # requires them relocated first. Note core.bare=false is written
                # into every non-bare repo and is harmless — only true matters.
                if git("config", "--local", "--get", "core.worktree",
                       cwd=src_wt, check=False):
                    raise Unsupported("core.worktree is set in shared config; "
                                      "relocate it before enabling worktreeConfig")
                if git("config", "--local", "--get", "core.bare",
                       cwd=src_wt, check=False) == "true":
                    raise Unsupported("core.bare is true in shared config; "
                                      "relocate it before enabling worktreeConfig")
                git("config", "extensions.worktreeConfig", "true", cwd=src_wt)
            git("config", "--worktree", "core.checkStat", "minimal", cwd=dst)
            checkout_cfg = ["-c", "core.checkStat=minimal"]

        t = time.perf_counter()
        argv = checkout_cfg + resolve_checkout(args, args.path)
        if args.quiet:
            argv.append("-q")
        git(*argv, cwd=dst)
        timings["delta_checkout"] = time.perf_counter() - t

        if args.exclude_ignored and not args.clean:
            # Not cloning ignored directories is only an optimisation; this pass
            # is what makes the flag exact, since the scattered ignored files
            # (*.pyc, .DS_Store) were deliberately left to it. It cannot touch a
            # tracked file, so the index stays true either way.
            t = time.perf_counter()
            git("clean", "-Xdff", cwd=dst)
            timings["clean_ignored"] = time.perf_counter() - t

        if args.clean:
            t = time.perf_counter()
            git("clean", "-xdff", cwd=dst)
            timings["clean"] = time.perf_counter() - t

    except BaseException as e:
        if created:
            git("worktree", "remove", "--force", dst, cwd=src_wt, check=False)
            shutil.rmtree(dst, ignore_errors=True)
            git("worktree", "prune", cwd=src_wt, check=False)
        if isinstance(e, Unsupported):
            run_fallback(str(e))
        if isinstance(e, (subprocess.CalledProcessError, OSError)):
            run_fallback(f"fast path failed ({e.__class__.__name__})")
        raise

    head = git("rev-parse", "--short", "HEAD", cwd=dst)
    mode = "checkStat=minimal" if args.no_patch else "index patched"
    dropped = f", {stats['excluded']} paths not cloned" if stats["excluded"] else ""
    say(f"wtclone: {dst} at {head} ({changed} files applied{dropped}, {mode})")
    if args.verbose:
        for k, v in timings.items():
            say(f"  {k:<15} {v:.3f}s")
        say(f"  {'TOTAL':<15} {sum(timings.values()):.3f}s")


if __name__ == "__main__":
    main()
